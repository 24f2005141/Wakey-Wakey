rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic connection verification document
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAlarm(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.lat is number
        && data.lng is number
        && data.radius is number && data.radius >= 50 && data.radius <= 50000
        && data.enabled is bool
        && data.sound is bool
        && data.vibration is bool
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.createdAt is number;
    }

    function isValidLocationLog(data) {
      return data.lat is number
        && data.lng is number
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.timestamp is number
        && data.createdAt is number;
    }

    function isValidUserLocation(data) {
      return data.lat is number
        && data.lng is number
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.timestamp is number
        && data.updatedAt is number;
    }

    // Alarms Collection
    match /alarms/{alarmId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(alarmId)
        && incoming().userId == request.auth.uid
        && isValidAlarm(incoming());
      allow update: if isSignedIn()
        && isValidId(alarmId)
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && isValidAlarm(incoming());
      allow delete: if isSignedIn()
        && isValidId(alarmId)
        && existing().userId == request.auth.uid;
    }

    // Real-time Active User Locations
    match /user_locations/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || (!isSignedIn() && userId == 'anonymous_tester');
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || (!isSignedIn() && resource.data.userId == 'anonymous_tester');
      allow create, update: if isValidId(userId)
        && (
             (isSignedIn() && request.auth.uid == userId && incoming().userId == request.auth.uid) ||
             (!isSignedIn() && userId == 'anonymous_tester' && incoming().userId == 'anonymous_tester')
           )
        && isValidUserLocation(incoming());
      allow delete: if (isSignedIn() && request.auth.uid == userId);
    }

    // Testing Location Logs Collection
    match /location_logs/{logId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(logId)
        && (
             (isSignedIn() && incoming().userId == request.auth.uid) ||
             (!isSignedIn() && incoming().userId == 'anonymous_tester')
           )
        && isValidLocationLog(incoming());
      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(logId)
        && existing().userId == request.auth.uid;
    }
  }
}
